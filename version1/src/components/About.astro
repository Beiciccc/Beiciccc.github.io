---
import { type Lang } from '../i18n/content';
import { Content as AboutEn } from '../content_data/about.en.md';
import { Content as AboutZh } from '../content_data/about.zh.md';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const heading = lang === 'zh' ? '关于' : 'About';
---

<!-- Side-head: the heading on the left, the text in a 40rem serif column on
     the right. -->
<section id="about" class="section" aria-labelledby="about-heading">
  <div class="container">
    <div class="section__inner">
      <div class="side grid reveal">
        <h2 id="about-heading" class="side__title">{heading}</h2>
        <div class="side__body prose about__body">
          {lang === 'en' ? <AboutEn /> : <AboutZh />}
        </div>
      </div>
    </div>
  </div>
</section>
