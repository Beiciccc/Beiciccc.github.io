---
import { type Lang, ui } from '../i18n/content';
import SectionHead from './SectionHead.astro';
import Corner from './Corner.astro';
import { Content as AboutEn } from '../content_data/about.en.md';
import { Content as AboutZh } from '../content_data/about.zh.md';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const heading = lang === 'zh' ? '关于' : 'About';
---

<!-- Set like a diploma: a double gilt frame with corner flourishes and an
     illuminated initial on the first paragraph. -->
<section id="about" class="section section--about" aria-labelledby="about-heading">
  <div class="container">
    <SectionHead id="about-heading" numeral="III" eyebrow={t.eyebrow.about} heading={heading} />
    <div class="folio reveal">
      {['tl', 'tr', 'bl', 'br'].map((c) => <Corner class={`folio__corner folio__corner--${c}`} />)}
      <div class="prose about__body">
        {lang === 'en' ? <AboutEn /> : <AboutZh />}
      </div>
    </div>
  </div>
</section>
