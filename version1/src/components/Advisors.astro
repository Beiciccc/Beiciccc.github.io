---
import { type Lang, advisors, pick } from '../i18n/content';

// Hidden since 2026-09-11 (see advisors.json _status). Set as a side-head
// like About, so it fits the page if it is shown again.
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const a = pick(advisors, lang);
---

<section id="advisors" class="section" aria-labelledby="advisors-heading">
  <div class="container">
    <div class="section__inner">
      <div class="side grid reveal">
        <h2 id="advisors-heading" class="side__title">{a.heading}</h2>
        <div class="side__body prose">
          <p>{a.entry}</p>

          <h3>{a.topicsLabel}</h3>
          <ol>
            {a.topics.map((tp) => <li>{tp}</li>)}
          </ol>

          <h3>{a.bringLabel}</h3>
          <p>{a.bring}</p>

          <h3>{a.needLabel}</h3>
          <p>{a.need}</p>

          <h3>{a.stopsLabel}</h3>
          <p>{a.stops}</p>
        </div>
      </div>
    </div>
  </div>
</section>
