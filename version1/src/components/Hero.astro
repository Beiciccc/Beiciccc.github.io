---
import { type Lang, hero, pick } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = pick(hero, lang);
---

<section class="section hero" aria-labelledby="hero-name">
  <div class="section__inner">
    <p class="hero__kicker">{h.kicker}</p>
    <h1 id="hero-name">{h.name}</h1>
    <p class="hero__tagline">{h.tagline}</p>
    <p class="lede hero__intro">{h.intro}</p>
    <div class="hero__actions">
      <a class="btn" href={h.ctaPrimary.href}>
        {h.ctaPrimary.label}
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--ghost" href={h.ctaSecondary.href} type="application/pdf">{h.ctaSecondary.label}</a>
    </div>
  </div>
</section>
