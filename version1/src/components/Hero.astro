---
import { type Lang, hero, site, publications, contact, ui, pick } from '../i18n/content';
import { splitWords } from '../i18n/split';
import Corner from './Corner.astro';
import Ornament from './Ornament.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = pick(hero, lang);
const s = pick(site, lang);
const t = ui[lang];

// Headline figures. Accepted / under review come from site.counts (the
// single place the public tally is kept); orals are counted from the paper
// list itself so the two can never disagree.
const items = publications.en.items;
const orals = items.filter((i) => i.format === 'Oral').length;
const oralMain = items.filter((i) => i.format === 'Oral' && i.tier === 'main').length;
const oralWs = items.filter((i) => i.format === 'Oral' && i.tier === 'workshop').length;
// Each figure links to the evidence for it.
const stats = [
  { n: s.counts.accepted, label: t.stats.accepted, href: '#publications', sub: '' },
  { n: orals, label: t.stats.oral, href: '#publications', sub: t.oralSplit(oralMain, oralWs) },
  { n: s.counts.underReview, label: t.stats.underReview, href: '#under-review', sub: '' },
  { n: s.counts.reviewerRoles, label: t.stats.reviewer, href: '#about', sub: '' },
];

// Kicker in two lines: the role, then the fields (each field kept whole).
const [kRole, kFields = ''] = h.kicker.split(' · ');
const fieldParts = kFields.split(/(,\s*|、)/);
// "Phase 2" never splits across lines.
const intro = h.intro.replace(/Phase (\d)/g, 'Phase\u00a0$1');

// Email and profiles next to the name. Profiles still without a URL
// (Scholar, ORCID) appear here by themselves once one is filled in.
const c = pick(contact, lang);
const mail = c.links.find((l) => l.href.startsWith('mailto:'));
const profiles = [
  ...c.links.filter((l) => l.href.startsWith('http')).map((l) => ({ label: l.label, href: l.href })),
  ...c.pending.filter((p) => p.href).map((p) => ({ label: p.label, href: p.href as string })),
];

// The name is set letter by letter for its gilded entrance; the plain text
// stays available to assistive tech (.sr-only) and the letters are hidden.
let ci = 0;
const nameWords = h.name.split(' ').map((word) => Array.from(word, (ch) => ({ ch, i: ci++ })));
// The tagline surfaces word by word (Chinese is segmented, see split.ts).
const tagline = splitWords(h.tagline, lang);

// Affiliation crest: the official University of Leeds mark, supplied as a
// file in src/assets/crest/ (SVG or transparent PNG) and set in ivory on a
// gilt plate. Until a file is there the plate carries the monogram.
const crestFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/crest/*.{svg,png,webp}', { eager: true });
const crest = Object.values(crestFiles)[0]?.default;
// How the mark is set on the plate:
//   'foil'     single-colour mark used as a mask over moving gold leaf;
//   'ivory'    any mark turned ivory (the usual reversed-out treatment);
//   'original' the file's own colours, untouched.
const CREST_TINT: 'foil' | 'ivory' | 'original' = 'foil';
---

<!-- Title page, printed like the frontispiece of a star atlas: an engraved
     chart with named constellations (canvas), the name in ink, and the
     university's mark on a gilt plate circled by an armillary ring. The
     headline figures run along the foot. Decoration is aria-hidden. -->
<section class="hero" aria-labelledby="hero-name">
  <div class="hero__sky" aria-hidden="true">
    <canvas class="hero__canvas"></canvas>
    <div class="hero__aurora"></div>
  </div>

  <div class="hero__inner">
    <div class="hero__text">
      <p class="hero__kicker rise" style="--d: 0">
        <span class="hero__kicker-rule" aria-hidden="true"></span>
        <span class="hero__kicker-text">
          <span class="hero__role">{kRole}</span>
          {
            kFields && (
              <span class="hero__fields">
                {fieldParts.map((part) => (/^(,\s*|、)$/.test(part) ? part : <span class="nobr">{part}</span>))}
              </span>
            )
          }
        </span>
      </p>
      <h1 id="hero-name" class="hero__name">
        <span class="sr-only">{h.name}</span>
        <span class="hero__letters" aria-hidden="true">
          {
            nameWords.map((word, wi) => (
              <Fragment>
                {wi > 0 && ' '}
                <span class="hero__word">
                  {word.map(({ ch, i }) => (
                    <span class="hero__ch" style={`--c: ${i}`}>
                      {ch}
                    </span>
                  ))}
                </span>
              </Fragment>
            ))
          }
        </span>
      </h1>
      <p class="hero__tagline">
        <em>
          {tagline.map((wd, i) => (wd === ' ' ? ' ' : <span class="hero__tw" style={`--w: ${i}`}>{wd}</span>))}
        </em>
      </p>
      <p class="hero__intro rise" style="--d: 3">{intro}</p>
      <div class="hero__actions rise" style="--d: 4">
        <a class="btn btn--gold" href={h.ctaPrimary.href}>
          {h.ctaPrimary.label}
          <!-- U+2192 is not in the self-hosted latin subset; draw the arrow. -->
          <svg class="btn__arrow" aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="14" height="14">
            <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a class="btn btn--glass" href={h.ctaSecondary.href} type="application/pdf">
          <svg class="btn__icon" aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="14" height="14">
            <path d="M4 1.75h5.2L12.5 5v9.25H4z M9 1.75V5.2h3.5 M6 8.25h4.5M6 10.75h4.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
          </svg>
          {h.ctaSecondary.label}
        </a>
      </div>
      <p class="hero__contact rise" style="--d: 4.5">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="15" height="15">
          <path d="M2 3.75h12v8.5H2zM2.5 4.25 8 8.75l5.5-4.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
        </svg>
        {mail && <a href={mail.href}>{mail.value}</a>}
        {
          profiles.map((p) => (
            <Fragment>
              <span class="hero__dot" aria-hidden="true">·</span>
              <a href={p.href} rel="me noopener noreferrer">
                {p.label}
              </a>
            </Fragment>
          ))
        }
      </p>
    </div>

    <div class="hero__crest rise" style="--d: 2">
      <div class="crest">
        <div class="crest__halo" aria-hidden="true"></div>
        <div class="crest__plate">
          {['tl', 'tr', 'bl', 'br'].map((c) => <Corner class={`crest__corner crest__corner--${c}`} />)}
          <Ornament variant="fleuron" class="crest__orn" />
          {
            crest && CREST_TINT === 'foil' ? (
              <span
                class="crest__logo crest__logo--foil"
                role="img"
                aria-label={t.crestAlt}
                style={`--logo: url("${crest.src}"); aspect-ratio: ${crest.width} / ${crest.height}`}
              />
            ) : crest ? (
              <img
                class:list={['crest__logo', `crest__logo--${CREST_TINT}`]}
                src={crest.src}
                width={crest.width}
                height={crest.height}
                alt={t.crestAlt}
                decoding="async"
              />
            ) : (
              <svg class="crest__mono" aria-hidden="true" focusable="false" viewBox="0 0 200 200" width="200" height="200">
                <defs>
                  <linearGradient id="mono-gold" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#f6e2a6" />
                    <stop offset=".5" stop-color="#d4ae5f" />
                    <stop offset="1" stop-color="#a47a2e" />
                  </linearGradient>
                </defs>
                <circle class="draw" pathLength="1" cx="100" cy="100" r="92" fill="none" stroke="url(#mono-gold)" stroke-width="1.2" />
                <circle cx="100" cy="100" r="84" fill="none" stroke="url(#mono-gold)" stroke-width=".7" stroke-dasharray="1 3.2" />
                <text x="100" y="124" text-anchor="middle" class="crest__mono-text" fill="url(#mono-gold)">KZ</text>
              </svg>
            )
          }
          {
            crest && (
              <p class="crest__caption">
                <span class="crest__rule" aria-hidden="true"></span>
                <span>{h.crestCaption}</span>
                <span class="crest__years">{h.crestYears}</span>
              </p>
            )
          }
          <span class="crest__gleam" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>

  <dl class="hero__stats rise" style="--d: 5">
    {
      stats.map((st) => (
        <div class="stat">
          <dt class="stat__label">
            {st.label}
            {st.sub && <span class="stat__sub">{st.sub}</span>}
          </dt>
          <dd class="stat__num">
            <a class="stat__link" href={st.href} data-count={st.n}>
              {st.n}
            </a>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<script>
  import { mountSky } from '../scripts/sky';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hero = document.querySelector<HTMLElement>('.hero');
  const canvas = hero?.querySelector<HTMLCanvasElement>('.hero__canvas');

  if (hero && canvas) {
    const text = hero.querySelector('.hero__text');
    const stats = hero.querySelector('.hero__stats');
    mountSky(hero, canvas, {
      asterisms: 'hero',
      nodeArea: 10500,
      starArea: 2400,
      motes: 16,
      flecks: 8,
      meteors: [16, 34],
      dustFrom: hero.querySelector('.hero__letters'),
      orbit: hero.querySelector('.crest__plate'),
      floor: stats,
      avoid: [text, stats].filter((el): el is Element => !!el),
      interactive: true,
    });
  }

  // The band of light that crossed the name on arrival crosses it again
  // when the pointer reaches it (Web Animations, so the entrance is not
  // restarted).
  const still = () => reduce || document.documentElement.dataset.motion === 'still';
  const name = hero?.querySelector<HTMLElement>('.hero__name');
  if (name && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let busy = false;
    name.addEventListener('pointerenter', () => {
      if (busy || still()) return;
      busy = true;
      const letters = Array.from(name.querySelectorAll<HTMLElement>('.hero__ch'));
      letters.forEach((ch, i) => {
        const a = ch.animate([{ backgroundPosition: '100% 0' }, { backgroundPosition: '0 0' }], {
          duration: 1400,
          delay: i * 30,
          easing: 'cubic-bezier(.22,.61,.36,1)',
        });
        if (i === letters.length - 1) a.onfinish = () => (busy = false);
      });
    });
  }

  // The crest leans toward the pointer and drifts a little slower than the
  // page as it scrolls away (wide screens, mouse, motion allowed).
  const crest = hero?.querySelector<HTMLElement>('.crest');
  const crestWrap = hero?.querySelector<HTMLElement>('.hero__crest');
  const wide = window.matchMedia('(min-width: 901px)');
  if (hero && crest && crestWrap && !reduce) {
    const clamp = (v: number) => Math.max(-1, Math.min(1, v));
    let tx = 0;
    let ty = 0;
    let cx = 0;
    let cy = 0;
    let raf = 0;
    const lean = () => {
      cx += (tx - cx) * 0.08;
      cy += (ty - cy) * 0.08;
      crest.style.transform = `perspective(1100px) rotateX(${cy.toFixed(2)}deg) rotateY(${cx.toFixed(2)}deg)`;
      raf = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.02 ? requestAnimationFrame(lean) : 0;
    };
    hero.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || !wide.matches || still()) return;
      const r = crest.getBoundingClientRect();
      tx = clamp((e.clientX - (r.left + r.width / 2)) / (window.innerWidth / 2)) * 4;
      ty = -clamp((e.clientY - (r.top + r.height / 2)) / (window.innerHeight / 2)) * 3;
      if (!raf) raf = requestAnimationFrame(lean);
    });
    hero.addEventListener('pointerleave', () => {
      tx = 0;
      ty = 0;
      if (!raf) raf = requestAnimationFrame(lean);
    });

    let sraf = 0;
    const drift = () => {
      sraf = 0;
      const y = wide.matches && !still() ? Math.min(window.scrollY, hero.offsetHeight) : 0;
      crestWrap.style.translate = y ? `0 ${(y * 0.14).toFixed(1)}px` : '';
    };
    window.addEventListener('scroll', () => {
      if (!sraf) sraf = requestAnimationFrame(drift);
    }, { passive: true });
    drift();
  }

  // Headline figures count up once when they first come into view.
  const nums = document.querySelectorAll<HTMLElement>('.stat__link[data-count]');
  const statsRow = document.querySelector<HTMLElement>('.hero__stats');
  if (nums.length && 'IntersectionObserver' in window && !still()) {
    let printing = false;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          const el = e.target as HTMLElement;
          const end = Number(el.dataset.count) || 0;
          const dur = 700;
          let t0 = 0;
          const tick = (now: number) => {
            if (printing) return;
            if (!t0) t0 = now;
            const p = Math.max(0, Math.min(1, (now - t0) / dur));
            el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(tick);
            else el.classList.add('is-counted');
          };
          // Count once the row has faded in, so the figures are seen moving
          // (it starts from nothing while the row is still transparent).
          el.textContent = '0';
          Promise.all((statsRow?.getAnimations() ?? []).map((a) => a.finished))
            .catch(() => undefined)
            .then(() => requestAnimationFrame(tick));
        }
      },
      { threshold: 0.6 }
    );
    nums.forEach((el) => io.observe(el));
    // A page printed mid-count must show the real figures.
    window.addEventListener('beforeprint', () => {
      printing = true;
      nums.forEach((el) => {
        io.unobserve(el);
        el.textContent = el.dataset.count ?? el.textContent;
      });
    });
  }
</script>
