---
import { type Lang, hero, site, publications, contact, ui, pick } from '../i18n/content';
import crestRaw from '../assets/crest/university-of-leeds.svg?raw';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = pick(hero, lang);
const s = pick(site, lang);
const t = ui[lang];

// Headline figures. Accepted / under review come from site.counts (the
// single place the public tally is kept); orals are counted from the paper
// list itself so the two can never disagree. Each figure links to the
// evidence for it.
const items = publications.en.items;
const orals = items.filter((i) => i.format === 'Oral').length;
const oralMain = items.filter((i) => i.format === 'Oral' && i.tier === 'main').length;
const oralWs = items.filter((i) => i.format === 'Oral' && i.tier === 'workshop').length;
const stats = [
  { n: s.counts.accepted, label: t.stats.accepted, href: '#publications', sub: '' },
  { n: orals, label: t.stats.oral, href: '#publications', sub: t.oralSplit(oralMain, oralWs) },
  { n: s.counts.underReview, label: t.stats.underReview, href: '#under-review', sub: '' },
  { n: s.counts.reviewerRoles, label: t.stats.reviewer, href: '#about', sub: '' },
];

// "Phase 2" never splits across lines; the year range never breaks.
const intro = h.intro.replace(/Phase (\d)/g, 'Phase $1');
const introParts = intro.split(/(\d{4}–\d{4})/).map((text, k) => ({ text, years: k % 2 === 1 }));
// The research directions, set off by middle dots.
const directions = h.tagline.split(/\s*·\s*/);

// Email and profiles under the lede. Profiles still without a URL
// (Scholar, ORCID) appear here by themselves once one is filled in.
const c = pick(contact, lang);
const mail = c.links.find((l) => l.href.startsWith('mailto:'));
const profiles = [
  ...c.links.filter((l) => l.href.startsWith('http')).map((l) => ({ label: l.label, href: l.href })),
  ...c.pending.filter((p) => p.href).map((p) => ({ label: p.label, href: p.href as string })),
];

// The University of Leeds mark, inlined so it takes the text colour
// (navy on ivory, ivory in dark mode, black in print, CanvasText in forced
// colours). Sizing comes from CSS; the label is localised.
const crestSvg = crestRaw
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/\s(width|height)="\d+"/g, '')
  .replace(/\srole="img"\saria-label="[^"]*"/, '')
  .replace('<svg ', `<svg role="img" aria-label="${t.crestAlt}" focusable="false" `)
  .replace('fill="#000"', 'fill="currentColor"')
  .replace(/(\d+\.\d)\d+/g, '$1');
---

<!-- Title block: name, directions and affiliation on the left, the lede and
     its actions on the right, the headline figures in a ruled row below.
     The entrance is pure CSS (global.css §12) and always ends visible; the
     name and lede only settle into place, so they are readable from the
     first frame. -->
<section class="hero" aria-labelledby="hero-name">
  <div class="container">
    <div class="hero__grid grid">
      <p class="hero__kicker in" style="--d: .05s">{h.kicker}</p>

      <div class="hero__id">
        <h1 id="hero-name" class="hero__name in in--settle">{h.name}</h1>
        <p class="hero__dirs in" style="--d: .1s">
          {/* No spaces between terms: the dot's padding is the gap, and <wbr>
              lets a narrow screen break before a dot, never after one. */}
          {
            directions.map((term, i) => (
              <Fragment>{i > 0 && <wbr />}<span class="nobr">{i > 0 && <span class="hero__sep" aria-hidden="true">·</span>}{term}</span>{i < directions.length - 1 && <span class="sr-only">{lang === 'zh' ? '、' : ', '}</span>}</Fragment>
            ))
          }
        </p>
        <div class="hero__aff in" style="--d: .16s">
          <span class="hero__crest" set:html={crestSvg} />
          <span class="hero__aff-rule" aria-hidden="true"></span>
          <p class="hero__aff-text">
            {h.crestCaption}
            <span class="hero__years">{h.crestYears}</span>
          </p>
        </div>
      </div>

      <div class="hero__body">
        <p class="hero__lede in in--settle" style="--d: .04s">
          {introParts.map((part) => (part.years ? <span class="nowrap">{part.text}</span> : part.text))}
        </p>
        <p class="hero__actions in" style="--d: .2s">
          <a class="btn btn--quiet" href={h.ctaPrimary.href}>
            {h.ctaPrimary.label}
            <!-- U+2193 is drawn: the arrow glyph varies too much between fallbacks. -->
            <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="14" height="14">
              <path d="M8 2.5v11M3.5 9 8 13.5 12.5 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a class="btn btn--quiet" href={h.ctaSecondary.href} type="application/pdf">{h.ctaSecondary.label}</a>
        </p>
        <p class="hero__links in" style="--d: .26s">
          {mail && <a href={mail.href}>{mail.value}</a>}
          {
            profiles.map((p) => (
              <a href={p.href} rel="me noopener noreferrer">
                {p.label}
              </a>
            ))
          }
        </p>
      </div>
    </div>

    <dl class="hero__stats grid">
      {
        stats.map((st, i) => (
          <div class="stat" style={`--i: ${i}`}>
            <dt>
              {st.label}
              {st.sub && (
                <span class="stat__sub">
                  {st.sub.split(' · ').map((seg, k) => (
                    <Fragment>
                      {k > 0 && ' · '}
                      <span class="seg">{seg}</span>
                    </Fragment>
                  ))}
                </span>
              )}
            </dt>
            <dd>
              <a class="stat__link" href={st.href}>
                {st.n}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
