---
import { getCollection } from 'astro:content';
import { type Lang, site, contact, ui, pick, localePath } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = pick(site, lang);
const t = ui[lang];
// The blog link only appears once there is at least one published post in
// this language.
const published = await getCollection('blog', ({ data }) => data.lang === lang && !data.draft);
const hasBlog = published.length > 0;
// On the homepage the footer offers the email; elsewhere it leads home.
const isHome = Astro.url.pathname === localePath(lang, '/');
const mail = pick(contact, lang).links.find((l) => l.href.startsWith('mailto:'));
// Build date, formatted per locale; the page is rebuilt on every deploy.
const built = new Date();
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const updated =
  lang === 'zh'
    ? `${built.getFullYear()} 年 ${built.getMonth() + 1} 月 ${built.getDate()} 日`
    : `${built.getDate()} ${MONTHS[built.getMonth()]} ${built.getFullYear()}`;
---

<!-- The one dark band on the page, in both themes. -->
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__inner grid">
      <p class="site-footer__name">
        {s.siteTitle}
        {lang === 'zh' && <span class="nav__latin" lang="en">Kun Zhang</span>}
      </p>
      <nav class="site-footer__nav" aria-label={lang === 'zh' ? '页脚导航' : 'Footer'}>
        {isHome && mail ? <a href={mail.href}>{mail.label}</a> : <a href={localePath(lang, '/')}>{s.backHome}</a>}
        {hasBlog && <a href={localePath(lang, '/blog/')}>{s.blogTitle}</a>}
        <a href="/cv.pdf" type="application/pdf">CV</a>
        <a href="https://github.com/Beiciccc" rel="me noopener noreferrer">GitHub</a>
        <a href="#main">{t.toTop}</a>
      </nav>
      <div class="site-footer__meta">
        <p>
          {s.footer} · {s.footerUpdated} <time datetime={built.toISOString().slice(0, 10)}>{updated}</time>
        </p>
        <p>{t.colophon}</p>
      </div>
    </div>
  </div>
</footer>
