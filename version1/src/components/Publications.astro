---
import { type Lang, publications, contact, ui, pick, pubIndex } from '../i18n/content';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = pick(publications, lang);
const t = ui[lang];
const tiers = ['main', 'workshop'] as const;
const anyMissingPdf = p.items.some((i) => !i.pdf);
const sep = lang === 'zh' ? '，' : ', ';
const paren = (s: string) => (lang === 'zh' ? `（${s}）` : ` (${s})`);

// Papers without a posted PDF offer one by email.
const email = pick(contact, lang).links.find((l) => l.href.startsWith('mailto:'))?.value;
const requestHref = (title: string) =>
  `mailto:${email}?subject=${encodeURIComponent(t.pubLinks.requestSubject + title)}`;
// Hyphenated compounds in titles ("Graph-Snapshot") break at the hyphen only
// when the whole word cannot fit a line (very narrow screens, large text).
const titleWords = (title: string) => title.split(' ');
// Presentation only: "(ρ = 0.945)" never breaks around the equals sign and
// "Phase 2" never splits.
const nbspEq = (s: string) => s.replace(/(\S) = (\S)/g, '$1\u00a0=\u00a0$2');
const nbspPhase = (s: string) => s.replace(/Phase (\d)/g, 'Phase\u00a0$1');
// Venue names break after their comma ("GroundLM 2026," / "workshop at
// EMNLP 2026"); a part wraps inside itself only when it cannot fit a line.
const venueChunks = (v: string) =>
  v.split(/(?<=[,，])\s*/).map((text, k, all) => ({ text, space: k > 0 && all[k - 1].endsWith(',') }));
---

<!-- Numbered bibliography, set as a ruled index: [n] | venue, format and
     track | the paper. The [n] stays plain text: the Research section
     refers back to these numbers. Rows are never hidden for an entrance. -->
<section id="publications" class="section" aria-labelledby="publications-heading">
  <div class="container">
    <div class="section__inner">
      <SectionHead id="publications-heading" heading={p.heading} sub={p.intro} aside={anyMissingPdf ? p.pdfNote : undefined} />

      <div class="pubs__body">
        {
          tiers.map((tier) => (
            <section class="pubs__group" aria-labelledby={`g-${tier}`}>
              <h3 id={`g-${tier}`} class="pubs__group-title">
                {p.groups[tier]}
              </h3>
              <ol class="pubs__list" role="list">
                {p.items
                  .filter((i) => i.tier === tier)
                  .map((item) => {
                    const oral = item.format === 'Oral';
                    const words = titleWords(item.title);
                    return (
                      <li class="pub" id={item.id}>
                        <p class="pub__num">[{pubIndex(item.id)}]</p>
                        <p class="pub__meta">
                          <span class="pub__venue">
                            {venueChunks(item.venue).map((c) => <Fragment>{c.space && ' '}<span class="pub__venue-part">{c.text}</span></Fragment>)}
                          </span>
                          {item.format && (
                            <span class:list={['pub__format', { 'pub__format--oral': oral }]}>{oral ? t.oral : item.format}</span>
                          )}
                          {/* On the one-line meta (below 1024px) each separator is glued to
                              the end of its segment, so a line can break after a dot but
                              never start with one. */}
                          <span class="pub__track">
                            {item.venueLong.split(' · ').map((seg, k, segs) => (
                              <Fragment>{k > 0 && ' '}<span class:list={['seg', { nobr: seg.length <= 16 }]}>{seg}{k < segs.length - 1 && <span class="dot" aria-hidden="true">{'\u00a0·'}</span>}</span></Fragment>
                            ))}
                          </span>
                        </p>
                        <div class="pub__main">
                          <h4 class="pub__title" lang="en">
                            {words.map((w, k) => (
                              <Fragment>
                                {w.includes('-') ? <span class="pub__word">{w}</span> : w}
                                {k < words.length - 1 ? ' ' : ''}
                              </Fragment>
                            ))}
                          </h4>
                          <p class="pub__byline">
                            {item.authors.map((a, k) => (
                              <Fragment>
                                {k > 0 && sep}
                                {a.self ? <strong class="pub__self">{a.name}</strong> : a.name}
                                {a.corresponding && paren(t.pubCorresponding)}
                              </Fragment>
                            ))}
                          </p>
                          <p class="pub__takeaway">{nbspEq(item.takeaway)}</p>
                          <details class="pub__more">
                            <summary>
                              <span>{t.pubAbstract}</span>
                              <svg class="pub__chev" aria-hidden="true" focusable="false" viewBox="0 0 12 12" width="10" height="10">
                                <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </summary>
                            <div class="pub__abstract">
                              <p class="pub__summary">{nbspEq(item.summary)}</p>
                              <p class="pub__scale">
                                {item.scale.split('–').map((x, k) => (
                                  <Fragment>
                                    {k > 0 && <span class="ndash">–</span>}
                                    {x}
                                  </Fragment>
                                ))}
                              </p>
                            </div>
                          </details>
                          <p class="pub__links">
                            {item.pdf && (
                              <a href={item.pdf} type="application/pdf">
                                {t.pubLinks.pdf}
                              </a>
                            )}
                            {item.links.map((l) => (
                              <a href={l.href} rel="noopener noreferrer">
                                {l.label}
                              </a>
                            ))}
                            {!item.pdf && email && <a href={requestHref(item.title)}>{t.pubLinks.request}</a>}
                          </p>
                        </div>
                      </li>
                    );
                  })}
              </ol>
            </section>
          ))
        }

        <!-- Under review: heading, body, topic areas and the withheld-details
             label only. Never a venue, venue type, rank, track or title. -->
        <aside id="under-review" class="review" aria-labelledby="ur-heading">
          <h3 id="ur-heading" class="pubs__group-title">{p.underReview.heading}</h3>
          <div class="review__panel">
            <p class="review__label">{t.sealedTitle}</p>
            <div class="review__body">
              <p class="review__text">{nbspPhase(p.underReview.body)}</p>
              <ul class="review__areas" role="list">
                {p.underReview.areas.map((a) => <li>{a}</li>)}
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</section>
