---
import { type Lang, research, pick, pubIndex } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const r = pick(research, lang);
const paren = (s: string) => (lang === 'zh' ? `（${s}）` : ` (${s})`);
---

<!-- Themes as a definition list. The [n] back-references are their own <dd>
     (a value of the term) so the subgrid can hang them in the rail on the
     same right-aligned axis as the paper numbers; below 900px they follow
     the title inline. -->
<section id="research" class="section section--rail" aria-labelledby="research-heading">
  <div class="section__inner">
    <h2 id="research-heading">{r.heading}</h2>
    <div class="section__body">
      <p class="lede">{r.intro}</p>

      <dl class="themes">
        {
          r.themes.map((th) => (
            <div class="theme">
              <dt class="theme__title">
                {th.title}
                {th.note && <span class="theme__note">{paren(th.note)}</span>}
              </dt>
              {th.refs.length > 0 && (
                <dd class="theme__refs">
                  {th.refs.map((id) => (
                    <a href={`#${id}`}>[{pubIndex(id)}]</a>
                  ))}
                </dd>
              )}
              <dd class="theme__body">{th.body}</dd>
            </div>
          ))
        }
      </dl>

      <p class="research__outro">{r.outro}</p>
    </div>
  </div>
</section>
