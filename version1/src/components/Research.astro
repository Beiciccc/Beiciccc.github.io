---
import { type Lang, research, publications, ui, pick, pubIndex, venueShort } from '../i18n/content';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const r = pick(research, lang);
const p = pick(publications, lang);
const t = ui[lang];
const paper = (id: string) => p.items.find((item) => item.id === id);
const paren = (s: string) => (lang === 'zh' ? `（${s}）` : ` (${s})`);

// The figure beside the outro is abstract by design: a measurement read
// against its null control, the idea shared by the accepted papers. Clay
// lines are the measured bundle; dashed grey lines are the control. It is
// schematic, not data, and must never be annotated: no axes, ticks, labels,
// numbers, legend or caption. Seeded, so every build is byte-identical; the
// call order below matters.
const mulberry32 = (a: number) => () => {
  a |= 0;
  a = (a + 0x6d2b79f5) | 0;
  let x = Math.imul(a ^ (a >>> 15), 1 | a);
  x = (x + Math.imul(x ^ (x >>> 7), 61 | x)) ^ x;
  return ((x ^ (x >>> 14)) >>> 0) / 4294967296;
};
const rnd = mulberry32(2026);
const gauss = () => {
  let u = 0;
  let v = 0;
  while (!u) u = rnd();
  while (!v) v = rnd();
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
};
const W = 960;
const Y0 = 240;
const bundle = (n: number, sigma: number, shift: number) =>
  Array.from({ length: n }, () => {
    const d = sigma * Math.max(-2.2, Math.min(2.2, gauss())) + shift;
    const c1 = 260 + rnd() * 80;
    const c2 = 560 + rnd() * 80;
    return {
      d: `M-20 ${Y0}C${c1.toFixed(0)} ${Y0} ${c2.toFixed(0)} ${(Y0 + 0.3 * d).toFixed(1)} ${W + 20} ${(Y0 + d).toFixed(1)}`,
      o: (0.35 + 0.5 * rnd()).toFixed(2),
    };
  });
const nullLines = bundle(28, 104, 0); // first
const measured = bundle(28, 100, 6); // second
---

<!-- Research themes as two ruled columns, each with [n] references back
     into the paper list (the number is the paper's place in Publications),
     then the figure and the closing paragraph. -->
<section id="research" class="section" aria-labelledby="research-heading">
  <div class="container">
    <div class="section__inner">
      <SectionHead id="research-heading" heading={r.heading} lede={r.intro} />

      <ol class="themes grid" role="list">
        {
          r.themes.map((th) => (
            <li class="theme">
              <h3 class="theme__title">
                {th.title}
                {th.note && th.refs.length === 0 && <span class="theme__note">{paren(th.note)}</span>}
              </h3>
              {th.body && <p class="theme__body">{th.body}</p>}
              {(th.refs.length > 0 || th.note) && (
                <p class="theme__refs">
                  <span class="theme__refs-label">{t.relatedPapers}</span>
                  {th.refs.map((id) => {
                    const it = paper(id);
                    return (
                      <a href={`#${id}`} title={it?.title}>
                        [{pubIndex(id)}]{it && ` ${venueShort(it.venue)}`}
                      </a>
                    );
                  })}
                  {th.note && <a href="#under-review">{p.underReview.heading}</a>}
                </p>
              )}
            </li>
          ))
        }
      </ol>

      <div class="feature grid">
        <figure class="feature__fig" aria-hidden="true" data-draw>
          <div class="fig__paper"></div>
          <div class="fig__layer fig__layer--null">
            <svg viewBox="0 0 960 480" preserveAspectRatio="xMinYMid slice" focusable="false">
              {nullLines.map((l) => <path d={l.d} opacity={l.o} />)}
            </svg>
          </div>
          <div class="fig__layer fig__layer--measured">
            <svg viewBox="0 0 960 480" preserveAspectRatio="xMinYMid slice" focusable="false">
              {measured.map((l) => <path d={l.d} opacity={l.o} />)}
            </svg>
          </div>
        </figure>
        <p class="feature__text">{r.outro}</p>
      </div>
    </div>
  </div>
</section>
