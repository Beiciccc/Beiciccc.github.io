---
import { type Lang, research, ui, pick, pubIndex } from '../i18n/content';
import { splitWords } from '../i18n/split';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const r = pick(research, lang);
const t = ui[lang];
const paren = (s: string) => (lang === 'zh' ? `（${s}）` : ` (${s})`);
const NUMERALS = ['I', 'II', 'III', 'IV', 'V', 'VI'];

// The pull quote is lit word by word as it is read (scroll-driven, see
// scripts/effects.ts); --k is each word's place in the sentence, 0…1.
const introWords = splitWords(r.intro, lang);
const lastWord = Math.max(1, introWords.length - 1);

// Orbits drifting behind the section: radius, planet size, tone, period (s).
const ORBITS = [
  { r: 250, size: 3.5, tone: 'gold', dash: '', period: 70, moon: false },
  { r: 370, size: 5, tone: 'crimson', dash: '2 7', period: 110, moon: false },
  { r: 500, size: 4.2, tone: 'pearl', dash: '', period: 150, moon: true },
  { r: 650, size: 6, tone: 'gold', dash: '1 9', period: 210, moon: false },
];
---

<!-- Three themes as arched panels (a triptych). Each carries a line emblem,
     its Roman numeral and [n] back-references into the paper list. -->
<section id="research" class="section section--research" aria-labelledby="research-heading">
  <div class="orbits" aria-hidden="true">
    <svg viewBox="-700 -700 1400 1400" width="1400" height="1400" focusable="false">
      {
        ORBITS.map((o, i) => (
          <g class={`orbit orbit--${i}`} style={`--period: ${o.period}s`}>
            <circle class="orbit__path" r={o.r} stroke-dasharray={o.dash || undefined} />
            <circle class={`orbit__body orbit__body--${o.tone}`} cx={o.r} cy="0" r={o.size} />
            {o.moon && (
              <g transform={`translate(${o.r} 0)`}>
                <g class="orbit__moon">
                  <circle class="orbit__path orbit__path--moon" r="16" />
                  <circle class="orbit__body orbit__body--gold" cx="16" cy="0" r="1.8" />
                </g>
              </g>
            )}
          </g>
        ))
      }
    </svg>
  </div>
  <div class="container">
    <SectionHead id="research-heading" numeral="II" eyebrow={t.eyebrow.research} heading={r.heading} />

    <blockquote class="pullquote reveal" data-scroll-lit>
      <p>
        {introWords.map((wd, i) => (wd === ' ' ? ' ' : <span class="lw" style={`--k: ${(i / lastWord).toFixed(3)}`}>{wd}</span>))}
      </p>
    </blockquote>

    <ol class="themes" role="list">
      {
        r.themes.map((th, i) => (
          <li class="theme reveal" style={`--i: ${i}`}>
            <div class="theme__crown" aria-hidden="true">
              <span class="theme__numeral">{NUMERALS[i]}</span>
              <svg class="theme__icon" viewBox="0 0 48 48" width="48" height="48" focusable="false">
                <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  {i === 0 && (
                    <Fragment>
                      {/* Balance: does the score weigh what it claims to? */}
                      <path class="draw" pathLength="1" d="M24 7v33M15 41h18M24 11l-14 4M24 11l14 4" />
                      <circle class="draw" pathLength="1" cx="24" cy="7" r="1.8" />
                      <path class="draw" pathLength="1" d="M10 15 4.5 27h11zM38 15l-5.5 12h11z" />
                      <path class="draw" pathLength="1" d="M4.5 27a5.5 3 0 0 0 11 0M32.5 27a5.5 3 0 0 0 11 0" />
                    </Fragment>
                  )}
                  {i === 1 && (
                    <Fragment>
                      {/* Lens over a small network: probing internal directions */}
                      <circle class="draw" pathLength="1" cx="20" cy="20" r="13" />
                      <path class="draw" pathLength="1" d="m29.5 29.5 11 11" stroke-width="2.6" />
                      <circle class="draw" pathLength="1" cx="14" cy="16" r="2" />
                      <circle class="draw" pathLength="1" cx="26" cy="15" r="2" />
                      <circle class="draw" pathLength="1" cx="20" cy="26" r="2" />
                      <path class="draw" pathLength="1" d="M16 16.3 24 15.2M15.2 17.7l3.6 6.6M25 16.8l-3.8 7.4" />
                    </Fragment>
                  )}
                  {i >= 2 && (
                    <Fragment>
                      {/* Shield with a compass star: alignment and safety */}
                      <path class="draw" pathLength="1" d="M24 4.5 39 10v12c0 10-6.6 17-15 21.5C15.6 39 9 32 9 22V10z" />
                      <path class="draw" pathLength="1" d="m24 13 2.4 7.6L34 23l-7.6 2.4L24 33l-2.4-7.6L14 23l7.6-2.4z" />
                      <circle class="draw" pathLength="1" cx="24" cy="23" r="1.4" />
                    </Fragment>
                  )}
                </g>
              </svg>
            </div>
            <h3 class="theme__title">
              {th.title}
              {th.note && <span class="theme__note">{paren(th.note)}</span>}
            </h3>
            <p class="theme__body">{th.body}</p>
            {th.refs.length > 0 && (
              <p class="theme__refs">
                <span class="theme__refs-label">{t.relatedPapers}</span>
                {th.refs.map((id) => (
                  <a href={`#${id}`}>[{pubIndex(id)}]</a>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ol>

    <p class="research__outro reveal">
      <span class="research__dagger" aria-hidden="true">†</span>
      {r.outro}
    </p>
  </div>
</section>
