---
import { type Lang, contact, pick } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = pick(contact, lang);
// Profiles without a URL yet (Scholar, ORCID) are not rendered.
const pending = c.pending.filter((x) => x.href);
const kind = (href: string) => (href.startsWith('mailto:') ? 'mail' : href.endsWith('.pdf') ? 'doc' : 'code');
const cards = [
  ...c.links.map((l) => ({ label: l.label, value: l.value, href: l.href, kind: kind(l.href) })),
  ...pending.map((l) => ({ label: l.label, value: l.label, href: l.href!, kind: 'code' })),
];
---

<!-- Side-head like About: the intro, then one ruled row per channel. -->
<section id="contact" class="section" aria-labelledby="contact-heading">
  <div class="container">
    <div class="section__inner">
      <div class="side grid reveal">
        <h2 id="contact-heading" class="side__title">{c.heading}</h2>
        <div class="side__body">
          <p class="contact__lede">{c.intro}</p>
          <dl class="contact__list">
            {
              cards.map((card) => (
                <div class:list={['contact__row', { 'contact__row--primary': card.kind === 'mail' }]}>
                  <dt>{card.label}</dt>
                  <dd>
                    {card.href.endsWith('.pdf') ? (
                      <a href={card.href} type="application/pdf">
                        {card.value}
                      </a>
                    ) : card.href.startsWith('http') ? (
                      <a href={card.href} rel="me noopener noreferrer">
                        {card.value}
                      </a>
                    ) : (
                      <a href={card.href}>{card.value}</a>
                    )}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>
