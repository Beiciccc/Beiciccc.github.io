---
import { type Lang, contact, ui, pick } from '../i18n/content';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = pick(contact, lang);
const t = ui[lang];
// Profiles without a URL yet (Scholar, ORCID) are not rendered.
const pending = c.pending.filter((x) => x.href);
const kind = (href: string) =>
  href.startsWith('mailto:') ? 'mail' : href.endsWith('.pdf') ? 'doc' : 'code';
const cards = [
  ...c.links.map((l) => ({ label: l.label, value: l.value, href: l.href, kind: kind(l.href) })),
  ...pending.map((l) => ({ label: l.label, value: l.label, href: l.href!, kind: 'code' })),
];
---

<!-- Closing band, midnight like the title page. One card per channel; the
     whole card is the link target (stretched ::after on the <a>). -->
<section id="contact" class="section section--contact band" aria-labelledby="contact-heading">
  <div class="band__sky" aria-hidden="true">
    <canvas class="band__canvas"></canvas>
  </div>
  <div class="container">
    <SectionHead id="contact-heading" numeral="IV" eyebrow={t.eyebrow.contact} heading={c.heading} />
    <p class="section-lede reveal">{c.intro}</p>

    <ul class="letters" role="list">
      {
        cards.map((card, i) => (
          <li class:list={['letter', 'reveal', { 'letter--primary': card.kind === 'mail' }]} style={`--i: ${i}`}>
            <span class="letter__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" focusable="false">
                <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  {card.kind === 'mail' && (
                    <Fragment>
                      <rect x="3" y="5.5" width="18" height="13" rx="1.5" />
                      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
                    </Fragment>
                  )}
                  {card.kind === 'doc' && (
                    <Fragment>
                      <path d="M6 2.75h8.5L19 7.25v14H6z" />
                      <path d="M14 2.75v4.75h5M9 12h7M9 15.5h7M9 9h3" />
                    </Fragment>
                  )}
                  {card.kind === 'code' && <path d="m8.5 7.5-5 4.5 5 4.5M15.5 7.5l5 4.5-5 4.5M13.5 5l-3 14" />}
                </g>
              </svg>
            </span>
            <span class="letter__label">{card.label}</span>
            {card.href.endsWith('.pdf') ? (
              <a class="letter__link" href={card.href} type="application/pdf">
                {card.value}
              </a>
            ) : card.href.startsWith('http') ? (
              <a class="letter__link" href={card.href} rel="me noopener noreferrer">
                {card.value}
              </a>
            ) : (
              <a class="letter__link" href={card.href}>
                {card.value}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { mountSky } from '../scripts/sky';

  // The closing band gets its own, quieter sky: fewer stars, the odd
  // shooting star, sparks where the visitor clicks.
  const band = document.querySelector<HTMLElement>('.section--contact');
  const canvas = band?.querySelector<HTMLCanvasElement>('.band__canvas');
  if (band && canvas) {
    mountSky(band, canvas, { nodeArea: 17000, starArea: 3000, motes: 14, meteors: [3.5, 8], interactive: true });
  }
</script>
