---
// Gilt corner flourish, drawn for the top-left corner; CSS mirrors it into
// the other three. The stroked paths carry pathLength="1" so they can be
// engraved in (stroke-dashoffset 1 → 0) when their block comes into view.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<svg class={cls} aria-hidden="true" focusable="false" viewBox="0 0 64 64" width="64" height="64">
  <g fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
    <path class="draw" pathLength="1" d="M6 62V6h56" />
    <path class="draw" pathLength="1" d="M12 62V12h50" opacity=".5" />
    <path class="draw" pathLength="1" d="M12 30c8 0 18-10 18-18M6 42c18 0 36-18 36-36" opacity=".7" />
    <path class="draw" pathLength="1" d="M20 21c2.5-3.5 7-3 7 .5s-3.5 4.5-5.2 2.4" />
  </g>
  <path class="gem" d="M6 .5 11.5 6 6 11.5.5 6z" fill="currentColor" />
</svg>
