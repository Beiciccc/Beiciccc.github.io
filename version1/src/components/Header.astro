---
import { type Lang, site, ui, pick, localePath } from '../i18n/content';

interface Props {
  lang: Lang;
  altUrl: string | null;
}

const { lang, altUrl } = Astro.props;
const s = pick(site, lang);
const t = ui[lang];
const homeHref = localePath(lang, '/');
// When a page has no counterpart in the other language, the toggle falls back
// to that language's homepage.
const toggleHref = altUrl ?? localePath(lang === 'en' ? 'zh' : 'en', '/');
const toggleHreflang = lang === 'en' ? 'zh-Hans' : 'en';

const navItems = s.nav.map((item) => {
  const isHash = item.href.startsWith('#');
  const isPdf = item.href.endsWith('.pdf');
  return { label: item.label, href: isHash ? `${homeHref}${item.href}` : item.href, isPdf };
});
---

<header class="site-header">
  <nav class="nav" aria-label={lang === 'zh' ? '主导航' : 'Primary'}>
    <a class="nav__brand" href={homeHref}>
      <!-- Monogram medallion: gilt ring, KZ in inscriptional capitals. -->
      <svg class="nav__mark" aria-hidden="true" focusable="false" viewBox="0 0 40 40" width="34" height="34">
        <circle cx="20" cy="20" r="18.6" fill="none" stroke="currentColor" stroke-width="1.1" />
        <circle class="nav__mark-ring" cx="20" cy="20" r="15.8" fill="none" stroke="currentColor" stroke-width=".6" stroke-dasharray=".8 1.6" />
        <text x="20" y="24.4" text-anchor="middle" class="nav__mark-text">KZ</text>
      </svg>
      <!-- English pages carry no Chinese; the Chinese pages add the Latin name. -->
      <span class="nav__name">
        {s.siteTitle}
        {lang === 'zh' && <span class="zh" lang="en">Kun Zhang</span>}
      </span>
    </a>

    <div class="nav__links">
      {
        navItems.map((item) =>
          item.isPdf ? (
            <a href={item.href} type="application/pdf" title={lang === 'zh' ? 'PDF，2 页' : 'PDF, 2 pages'}>
              {item.label}
            </a>
          ) : (
            <a href={item.href}>{item.label}</a>
          )
        )
      }
    </div>

    <div class="nav__tools">
      <!-- Language switch, labelled with ISO codes so English pages stay
           free of Chinese script. -->
      <a
        class="toggle toggle__lang"
        href={toggleHref}
        hreflang={toggleHreflang}
        aria-label={s.langToggleLabel}
        title={s.langToggleLabel}
      >
        <span class={lang === 'en' ? 'on' : ''}>EN</span>
        <span class="sep" aria-hidden="true">/</span>
        <span class={lang === 'zh' ? 'on' : ''}>ZH</span>
      </a>

      <!-- Three-state theme control: system → light → dark → system. Icon and
           aria-label reflect the *setting*, not the resolved colour. Hidden
           without JS (html:not(.js)). -->
      <button
        id="theme-toggle"
        class="toggle toggle__theme"
        type="button"
        aria-label={s.themeToggleLabel}
        title={s.themeToggleLabel}
        data-label-light={t.themeLight}
        data-label-dark={t.themeDark}
        data-label-system={t.themeSystem}
      >
        <!-- Inline SVG so the three glyphs render identically on every platform. -->
        <svg data-icon="system" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="14" height="14">
          <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M12 3.5a8.5 8.5 0 0 0 0 17Z" fill="currentColor" />
        </svg>
        <svg data-icon="sun" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.5" />
          <path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1" />
        </svg>
        <svg data-icon="moon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="14" height="14">
          <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a7 7 0 0 0 10.7 10.7Z" fill="currentColor" />
        </svg>
      </button>
    </div>
  </nav>
  <!-- Reading progress: a gilt hairline scaled by the inline script. -->
  <div class="scroll-progress" aria-hidden="true"><span></span></div>
</header>
