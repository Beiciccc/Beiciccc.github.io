---
import { type Lang, site, contact, ui, pick, localePath } from '../i18n/content';

interface Props {
  lang: Lang;
  altUrl: string | null;
}

const { lang, altUrl } = Astro.props;
const s = pick(site, lang);
const t = ui[lang];
const homeHref = localePath(lang, '/');
// When a page has no counterpart in the other language, the toggle falls back
// to that language's homepage.
const toggleHref = altUrl ?? localePath(lang === 'en' ? 'zh' : 'en', '/');
const toggleHreflang = lang === 'en' ? 'zh-Hans' : 'en';

// Sections in page order, Contact last. The CV file is the one filled
// button at the right of the bar.
const sections = [...s.nav.filter((i) => !i.href.endsWith('.pdf')), { label: pick(contact, lang).heading, href: '#contact' }].map(
  (item) => ({ label: item.label, href: item.href.startsWith('#') ? `${homeHref}${item.href}` : item.href })
);
const cv = s.nav.find((i) => i.href.endsWith('.pdf'));
---

<header class="site-header">
  <nav class="nav container" aria-label={lang === 'zh' ? '主导航' : 'Primary'}>
    <!-- English pages carry no Chinese; the Chinese pages add the Latin name. -->
    <a class="nav__brand" href={homeHref}>
      {s.siteTitle}
      {lang === 'zh' && <span class="nav__latin" lang="en">Kun Zhang</span>}
    </a>

    <div class="nav__links">
      {sections.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>

    <div class="nav__tools">
      <!-- Language switch, labelled with ISO codes so English pages stay
           free of Chinese script. -->
      <a class="toggle__lang" href={toggleHref} hreflang={toggleHreflang} title={s.langToggleLabel}>
        <span class={lang === 'en' ? 'on' : ''}>EN</span>
        <span aria-hidden="true">/</span>
        <span class={lang === 'zh' ? 'on' : ''}>ZH</span>
        <span class="sr-only">, {s.langToggleLabel}</span>
      </a>

      <!-- Three-state theme control: system → light → dark → system. Icon and
           aria-label reflect the *setting*, not the resolved colour. Hidden
           without JS (html:not(.js)). -->
      <button
        id="theme-toggle"
        class="icon-btn toggle__theme"
        type="button"
        aria-label={s.themeToggleLabel}
        title={s.themeToggleLabel}
        data-label-light={t.themeLight}
        data-label-dark={t.themeDark}
        data-label-system={t.themeSystem}
      >
        <!-- Inline SVG so the three glyphs render identically on every platform. -->
        <svg data-icon="system" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16">
          <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="M12 3.5a8.5 8.5 0 0 0 0 17Z" fill="currentColor" />
        </svg>
        <svg data-icon="sun" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.5" />
          <path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1" />
        </svg>
        <svg data-icon="moon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16">
          <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a7 7 0 0 0 10.7 10.7Z" fill="currentColor" />
        </svg>
      </button>

      {cv && (
        <a class="btn btn--dark" href={cv.href} type="application/pdf" title={lang === 'zh' ? 'PDF，2 页' : 'PDF, 2 pages'}>
          {cv.label}
        </a>
      )}
    </div>
  </nav>
</header>
