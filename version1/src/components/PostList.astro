---
import type { CollectionEntry } from 'astro:content';
import { type Lang, baseSlug, formatDate, localePath } from '../i18n/content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  lang: Lang;
}
const { posts, lang } = Astro.props;
---

<!-- An index table without a header row: date | category | title. -->
<div class="post-list">
  {
    posts.map((post) => {
      const href = localePath(lang, `/blog/${baseSlug(post.filePath)}/`);
      return (
        <article class="post-row">
          <time class="post-row__date" datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate, lang)}
          </time>
          <span class="post-row__cat">{post.data.tags?.[0] ?? ''}</span>
          <div>
            <h2 class="post-row__title">
              <a href={href}>{post.data.title}</a>
            </h2>
            <p class="post-row__excerpt">{post.data.description}</p>
          </div>
        </article>
      );
    })
  }
</div>
