---
// Section head shared by Publications and Research: the heading (with an
// optional one-line sub) on the left, a serif lede or a small aside on the
// right, on the same 12-column grid as the title block.
interface Props {
  id: string;
  heading: string;
  sub?: string;
  lede?: string;
  aside?: string;
}
const { id, heading, sub, lede, aside } = Astro.props;
---

<header class:list={['sec-head', 'grid', 'reveal', { 'sec-head--aside': aside }]}>
  <div class="sec-head__main">
    <h2 id={id} class="sec-head__title">{heading}</h2>
    {sub && <p class="sec-head__sub">{sub}</p>}
  </div>
  {lede && <p class="sec-head__lede">{lede}</p>}
  {aside && <p class="sec-head__aside">{aside}</p>}
</header>
