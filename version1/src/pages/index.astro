---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Publications from '../components/Publications.astro';
import Research from '../components/Research.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { site, pick, homeJsonLd } from '../i18n/content';

const lang = 'en';
const s = pick(site, lang);
---

<BaseLayout lang={lang} title={s.homeTitle} description={s.siteDescription} altUrl="/zh/" jsonLd={homeJsonLd(lang)}>
  <Hero lang={lang} />
  <Publications lang={lang} />
  <Research lang={lang} />
  <About lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
