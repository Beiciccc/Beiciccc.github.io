---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { site, pick, ui } from '../../../i18n/content';

const lang = 'zh';
const s = pick(site, lang);
const t = ui[lang];

const posts = (await getCollection('blog', ({ data }) => data.lang === 'zh' && !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  lang={lang}
  title={s.blogTitle + ' · ' + s.siteTitle}
  description={s.blogIntro}
  altUrl="/blog/"
>
  <section class="section blog-index" aria-labelledby="blog-heading">
  <div class="section__inner">
    <div class="blog-index__head">
      <h1 id="blog-heading">{s.blogTitle}</h1>
      <p class="lede blog-index__intro">{s.blogIntro}</p>
    </div>
    {posts.length > 0 ? <PostList posts={posts} lang={lang} /> : <p class="meta">{t.noPosts}</p>}
    </div>
  </section>
</BaseLayout>
