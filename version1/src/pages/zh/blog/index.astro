---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { site, pick, ui } from '../../../i18n/content';

const lang = 'zh';
const s = pick(site, lang);
const t = ui[lang];

const posts = (await getCollection('blog', ({ data }) => data.lang === 'zh' && !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  lang={lang}
  title={s.blogTitle + ' · ' + s.siteTitle}
  description={s.blogIntro}
  altUrl="/blog/"
>
  <section class="page-head container grid" aria-labelledby="blog-heading">
    <div class="page-head__main">
      <h1 id="blog-heading" class="page-head__title">{s.blogTitle}</h1>
    </div>
    <div class="page-head__body">
      <p class="page-head__lede">{s.blogIntro}</p>
    </div>
  </section>
  <div class="container">
    {
      posts.length > 0 ? (
        <PostList posts={posts} lang={lang} />
      ) : (
        <div class="post-list">
          <p class="post-empty">{t.noPosts}</p>
        </div>
      )
    }
  </div>
</BaseLayout>
