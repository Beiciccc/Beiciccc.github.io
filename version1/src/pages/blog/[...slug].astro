---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { baseSlug, formatDate, localePath, ui } from '../../i18n/content';

export const getStaticPaths = (async () => {
  const all = await getCollection('blog');
  const en = all.filter((p) => p.data.lang === 'en' && !p.data.draft);
  // Base slugs that have a Chinese counterpart → used to decide if the lang
  // toggle should point at a translated post or fall back to the ZH blog index.
  const zhSlugs = new Set(
    all.filter((p) => p.data.lang === 'zh' && !p.data.draft).map((p) => baseSlug(p.filePath))
  );

  return en.map((post) => {
    const slug = baseSlug(post.filePath);
    return {
      params: { slug },
      props: { post, hasZh: zhSlugs.has(slug), slug },
    };
  });
}) satisfies GetStaticPaths;

const { post, hasZh, slug } = Astro.props;
const { Content } = await render(post);

const lang = 'en';
const t = ui[lang];
// The arrow is drawn (SVG), so the label drops the text arrow.
const backLabel = t.backToBlog.replace(/^←\s*/, '');
// Toggle to the translated post when it exists; otherwise no alternate.
// Trailing slashes so the alt/hreflang URL byte-matches the target page's
// emitted canonical (directory pages are served with a trailing slash).
const altUrl = hasZh ? localePath('zh', `/blog/${slug}/`) : null;
---

<BaseLayout
  lang={lang}
  title={post.data.title + ' — Kun Zhang'}
  description={post.data.description}
  altUrl={altUrl}
>
  <article class="post-page container">
    <a class="post-page__back" href={localePath(lang, '/blog/')}>
      <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="14" height="14">
        <path d="M13.5 8h-11M7 3.5 2.5 8 7 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {backLabel}
    </a>

    <header class="post-page__head">
      {post.data.tags?.[0] && <p class="post-page__cat">{post.data.tags[0]}</p>}
      <h1 class="post-page__title">{post.data.title}</h1>
      <p class="post-page__date">
        <time datetime={post.data.pubDate.toISOString()}>
          {t.publishedOn} {formatDate(post.data.pubDate, lang)}
        </time>
      </p>
      {
        post.data.tags && (
          <ul class="post-page__tags">
            {post.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose post-page__body">
      <Content />
    </div>

    <footer class="post-page__foot">
      <a class="btn btn--quiet btn--lg" href={localePath(lang, '/blog/')}>
        <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="14" height="14">
          <path d="M13.5 8h-11M7 3.5 2.5 8 7 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {backLabel}
      </a>
    </footer>
  </article>
</BaseLayout>
