---
// Self-hosted type (Vite hashes the woff2 into _astro/; unicode-range means
// only the latin files are fetched for these pages).
// Source Serif 4: roman with the opsz axis + true italic — running text.
// Source Sans 3:  roman, wght axis — apparatus (bylines, nav, buttons).
// Cormorant Garamond: roman + italic, wght axis — display (name, headings, titles).
// Cinzel: inscriptional capitals — numerals, eyebrows, the astrolabe ring.
// Imported before global.css so the @font-face rules precede their first use.
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/cinzel/wght.css';
import serifWoff2 from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import displayWoff2 from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, htmlLang, ui } from '../i18n/content';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Absolute path of the equivalent page in the other language; null when none exists. */
  altUrl: string | null;
  /** Optional JSON-LD graph nodes (the homepage passes WebSite + Person). */
  jsonLd?: Record<string, unknown>[];
}

const { lang, title, description, altUrl, jsonLd } = Astro.props;
const t = ui[lang];

// Single source of truth: `site` from astro.config.mjs (lowercase host, as
// served by GitHub Pages) so canonical / og / hreflang URLs are byte-consistent.
const siteUrl = Astro.site?.href ?? 'https://beiciccc.github.io/';
const canonical = new URL(Astro.url.pathname, siteUrl).href;

// Social cards must be raster (X, Facebook, LinkedIn, Slack, iMessage do not
// render SVG). One card per language.
const ogImage = new URL(lang === 'zh' ? '/og-default.zh.png' : '/og-default.png', siteUrl).href;
const ogAlt =
  lang === 'zh'
    ? '张鲲 Kun Zhang，博士申请人，大语言模型后训练与对齐；5 篇录用，2 篇在投'
    : 'Kun Zhang, PhD applicant, LLM post-training and alignment; 5 accepted, 2 under review';

// hreflang alternates. A page without a counterpart only declares itself.
const altCanonical = altUrl ? new URL(altUrl, siteUrl).href : null;
const enHref = lang === 'en' ? canonical : altCanonical;
const zhHref = lang === 'zh' ? canonical : altCanonical;
const xDefault = enHref ?? canonical;
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- The masthead is midnight in both themes. -->
    <meta name="theme-color" content="#0b1226" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Only the files the first paint needs (display h1 + running text). The
         italics, the sans and Cinzel arrive via font-display: swap behind
         fallbacks declared in global.css. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href={displayWoff2} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={serifWoff2} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kun Zhang" />
    <link rel="canonical" href={canonical} />

    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    {zhHref && <link rel="alternate" hreflang="zh-Hans" href={zhHref} />}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kun Zhang" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_GB'} />
    {altCanonical && <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_GB' : 'zh_CN'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd })} />
    )}

    <!-- No-flash bootstrap: mark JS-enabled and apply a stored theme choice
         before first paint. No stored choice = follow the OS (no attribute). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var v = localStorage.getItem('theme');
          if (v === 'light' || v === 'dark') root.setAttribute('data-theme', v);
        } catch (e) {
          /* storage unavailable: follow the OS */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <Header lang={lang} altUrl={altUrl} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Back to top: a small gilt dial whose ring fills as the page is read.
         Appears once the title page has scrolled away. -->
    <a class="to-top" href="#main" aria-label={t.toTop} title={t.toTop}>
      <svg viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" focusable="false">
        <circle class="to-top__track" cx="24" cy="24" r="21" />
        <circle class="to-top__bar" cx="24" cy="24" r="21" pathLength="1" />
        <g class="to-top__dial">
          <path d="M24 5.5v3M24 39.5v3M5.5 24h3M39.5 24h3" />
        </g>
        <path class="to-top__arrow" d="M24 31V17.5M18.5 23 24 17.5 29.5 23" />
      </svg>
    </a>

    <script is:inline>
      (function () {
        var root = document.documentElement;

        // THEME: three states, system → light → dark → system. The icon is
        // keyed off data-state (CSS); the label names the current setting.
        var btn = document.getElementById('theme-toggle');
        function stored() {
          try {
            var v = localStorage.getItem('theme');
            return v === 'light' || v === 'dark' ? v : 'system';
          } catch (e) {
            return 'system';
          }
        }
        function apply(state) {
          if (state === 'system') root.removeAttribute('data-theme');
          else root.setAttribute('data-theme', state);
          if (!btn) return;
          btn.setAttribute('data-state', state);
          var label = btn.getAttribute('data-label-' + state);
          if (label) {
            btn.setAttribute('aria-label', label);
            btn.setAttribute('title', label);
          }
        }
        apply(stored());
        if (btn) {
          btn.addEventListener('click', function () {
            var order = ['system', 'light', 'dark'];
            var next = order[(order.indexOf(stored()) + 1) % order.length];
            try {
              if (next === 'system') localStorage.removeItem('theme');
              else localStorage.setItem('theme', next);
            } catch (e) {}
            apply(next);
          });
        }

        // NAV: settle the sticky bar once scrolled and advance the gilt
        // reading-progress hairline. One rAF-throttled listener.
        var bar = document.querySelector('.scroll-progress span');
        var toTop = document.querySelector('.to-top');
        var ticking = false;
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            var y = window.scrollY;
            document.body.classList.toggle('scrolled', y > 8);
            var max = document.documentElement.scrollHeight - window.innerHeight;
            var p = max > 0 ? Math.min(1, y / max) : 0;
            if (bar) bar.style.transform = 'scaleX(' + p.toFixed(4) + ')';
            if (toTop) {
              toTop.style.setProperty('--progress', p.toFixed(4));
              toTop.classList.toggle('is-shown', y > window.innerHeight * 0.8);
            }
            ticking = false;
          });
        }
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });

        // REVEAL: blocks marked .reveal rise into place the first time they
        // enter the viewport. The hidden state only exists in CSS under
        // html.js + no-preference motion, so no-JS and reduced-motion
        // visitors always see everything; any failure here shows it all too.
        var reveals = document.querySelectorAll('.reveal');
        function showAll() {
          reveals.forEach(function (el) { el.classList.add('is-in'); });
        }
        try {
          if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            showAll();
          } else {
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add('is-in');
                  io.unobserve(e.target);
                }
              });
            }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
            reveals.forEach(function (el) { io.observe(el); });
            // Printing or jumping to a #fragment must never meet hidden blocks.
            window.addEventListener('beforeprint', showAll);
            window.addEventListener('hashchange', function () {
              var tgt = location.hash && document.getElementById(location.hash.slice(1));
              if (tgt) {
                tgt.classList.add('is-in');
                var inner = tgt.closest('.reveal');
                if (inner) inner.classList.add('is-in');
              }
            });
          }
        } catch (e) {
          showAll();
        }

        // SCROLLSPY: mark the nav link of the section being read.
        try {
          var links = {};
          document.querySelectorAll('.nav__links a[href*="#"]').forEach(function (a) {
            links[a.getAttribute('href').split('#')[1]] = a;
          });
          var ids = Object.keys(links);
          if (ids.length && 'IntersectionObserver' in window) {
            var spy = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                var a = links[e.target.id];
                if (!a) return;
                if (e.isIntersecting) {
                  ids.forEach(function (id) { links[id].removeAttribute('aria-current'); });
                  a.setAttribute('aria-current', 'location');
                } else if (a.getAttribute('aria-current')) {
                  a.removeAttribute('aria-current');
                }
              });
            }, { rootMargin: '-45% 0px -50% 0px' });
            ids.forEach(function (id) {
              var sec = document.getElementById(id);
              if (sec) spy.observe(sec);
            });
          }
        } catch (e) {}

        // PRINT: open every abstract for the printed page, then restore.
        var details = document.querySelectorAll('details.pub__more');
        window.addEventListener('beforeprint', function () {
          details.forEach(function (d) {
            d.setAttribute('data-was-open', d.open ? '1' : '');
            d.open = true;
          });
        });
        window.addEventListener('afterprint', function () {
          details.forEach(function (d) {
            d.open = d.getAttribute('data-was-open') === '1';
            d.removeAttribute('data-was-open');
          });
        });
      })();
    </script>

    <!-- Pointer and scroll ornament (spotlight, tilt, cursor dust, scroll-lit
         quote). Bundled and deferred; the page is complete without it. -->
    <script>
      import '../scripts/effects';
    </script>
  </body>
</html>
