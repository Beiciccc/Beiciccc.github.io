---
// Self-hosted type (Vite hashes the woff2 into _astro/; unicode-range means
// only the latin files are fetched for these pages).
// Schibsted Grotesk: wght axis — names, headings, navigation, apparatus.
// Literata: roman + italic, wght axis — running text and ledes.
// Imported before global.css so the @font-face rules precede their first use.
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource-variable/literata/wght.css';
import '@fontsource-variable/literata/wght-italic.css';
import sansWoff2 from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import serifWoff2 from '@fontsource-variable/literata/files/literata-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, htmlLang, ui } from '../i18n/content';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Absolute path of the equivalent page in the other language; null when none exists. */
  altUrl: string | null;
  /** Optional JSON-LD graph nodes (the homepage passes WebSite + Person). */
  jsonLd?: Record<string, unknown>[];
}

const { lang, title, description, altUrl, jsonLd } = Astro.props;
const t = ui[lang];

// Single source of truth: `site` from astro.config.mjs (lowercase host, as
// served by GitHub Pages) so canonical / og / hreflang URLs are byte-consistent.
const siteUrl = Astro.site?.href ?? 'https://beiciccc.github.io/';
const canonical = new URL(Astro.url.pathname, siteUrl).href;

// Social cards must be raster (X, Facebook, LinkedIn, Slack, iMessage do not
// render SVG). One card per language.
const ogImage = new URL(lang === 'zh' ? '/og-default.zh.png' : '/og-default.png', siteUrl).href;
const ogAlt =
  lang === 'zh'
    ? '张鲲 Kun Zhang，博士申请人，大语言模型后训练、对齐与评测；5 篇录用，3 篇在投'
    : 'Kun Zhang, PhD applicant, LLM post-training, alignment and evaluation; 5 accepted, 3 under review';

// hreflang alternates. A page without a counterpart only declares itself.
const altCanonical = altUrl ? new URL(altUrl, siteUrl).href : null;
const enHref = lang === 'en' ? canonical : altCanonical;
const zhHref = lang === 'zh' ? canonical : altCanonical;
const xDefault = enHref ?? canonical;
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f5" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1f1e1d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Only the files the first paint needs (sans + serif roman). The italic
         and the Greek subset arrive via font-display: swap behind the
         metric-matched fallbacks declared in global.css. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href={sansWoff2} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={serifWoff2} />
    <!-- Chinese pages: the subset Song face for the ledes. -->
    {lang === 'zh' && <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/kz-serif-sc.woff2" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kun Zhang" />
    <link rel="canonical" href={canonical} />

    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    {zhHref && <link rel="alternate" hreflang="zh-Hans" href={zhHref} />}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kun Zhang" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_GB'} />
    {altCanonical && <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_GB' : 'zh_CN'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd })} />
    )}

    <!-- No-flash bootstrap: mark JS-enabled and apply a stored theme choice
         before first paint. No stored choice = follow the OS (no attribute).
         The old "pause motion" preference is cleared: nothing loops now. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var v = localStorage.getItem('theme');
          if (v === 'light' || v === 'dark') root.setAttribute('data-theme', v);
          localStorage.removeItem('motion');
        } catch (e) {
          /* storage unavailable: follow the OS */
        }
      })();
    </script>
  </head>
  <body>
    <!-- Watched by the header script: once it leaves the viewport the sticky
         header shows its hairline (no scroll listener). -->
    <span id="top-sentinel" aria-hidden="true"></span>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <Header lang={lang} altUrl={altUrl} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Theme toggle, header hairline, scroll reveals, the figure draw,
         scrollspy and print. Hidden states exist only in CSS under html.js
         and no-preference motion, and every failure path shows everything. -->
    <script is:inline>
(function () {
  var root = document.documentElement, mq = function (q) { return window.matchMedia(q).matches; };
  var reduce = mq('(prefers-reduced-motion: reduce)'), IO = 'IntersectionObserver' in window;
  function add(el) { el.classList.add('is-in'); }

  // Theme: system -> light -> dark -> system; the switch itself is instant.
  var btn = document.getElementById('theme-toggle');
  function stored() { try { var v = localStorage.getItem('theme'); return v === 'light' || v === 'dark' ? v : 'system'; } catch (e) { return 'system'; } }
  function apply(st) {
    if (st === 'system') root.removeAttribute('data-theme'); else root.setAttribute('data-theme', st);
    if (!btn) return;
    btn.setAttribute('data-state', st);
    var l = btn.getAttribute('data-label-' + st);
    if (l) { btn.setAttribute('aria-label', l); btn.setAttribute('title', l); }
  }
  apply(stored());
  if (btn) btn.addEventListener('click', function () {
    var o = ['system', 'light', 'dark'], next = o[(o.indexOf(stored()) + 1) % 3];
    try { if (next === 'system') localStorage.removeItem('theme'); else localStorage.setItem('theme', next); } catch (e) {}
    root.classList.add('theme-switch');
    apply(next);
    getComputedStyle(root).color;
    requestAnimationFrame(function () { root.classList.remove('theme-switch'); });
  });

  // Smooth anchor scrolling only after load, so a deep link jumps straight there.
  window.addEventListener('load', function () { requestAnimationFrame(function () { root.classList.add('smooth'); }); });

  // Header hairline once the top sentinel leaves the viewport.
  try {
    var sentinel = document.getElementById('top-sentinel');
    if (sentinel && IO) new IntersectionObserver(function (es) { document.body.classList.toggle('scrolled', !es[0].isIntersecting); }).observe(sentinel);
  } catch (e) {}

  // Reveals and the figure draw. Reveals in view on a top-of-page load wait
  // for the hero to settle (--rd); deep links and restored scroll do not.
  var reveals = document.querySelectorAll('.reveal'), draws = document.querySelectorAll('[data-draw]');
  function showAll() { reveals.forEach(add); draws.forEach(add); }
  function showTarget() {
    var id = location.hash && decodeURIComponent(location.hash.slice(1)), t = id && document.getElementById(id);
    if (!t) return;
    if (t.matches('.reveal,[data-draw]')) add(t);
    var o = t.closest('.reveal'); if (o) add(o);
    t.querySelectorAll('.reveal,[data-draw]').forEach(add);
  }
  function once(opts, first) {
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { if (first && !window.scrollY && !e.target.classList.contains('is-in')) e.target.style.setProperty('--rd', '.56s'); add(e.target); io.unobserve(e.target); } });
      first = false;
    }, opts);
    return io;
  }
  try {
    if (!IO || reduce) showAll();
    else {
      var rio = once({ rootMargin: '0px 0px -8% 0px', threshold: 0.08 }, true), fio = once({ threshold: 0.35 });
      reveals.forEach(function (el) { rio.observe(el); });
      draws.forEach(function (el) { fio.observe(el); });
      showTarget();
      window.addEventListener('hashchange', showTarget);
    }
  } catch (e) { showAll(); }

  // Scrollspy; on phones the current link is kept in view in the nav row.
  try {
    var links = {};
    document.querySelectorAll('.nav__links a[href*="#"]').forEach(function (a) { links[a.getAttribute('href').split('#')[1]] = a; });
    var ids = Object.keys(links);
    if (ids.length && IO) {
      var spy = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          var a = links[e.target.id];
          if (!a) return;
          if (e.isIntersecting) {
            ids.forEach(function (id) { links[id].removeAttribute('aria-current'); });
            a.setAttribute('aria-current', 'location');
            var row = a.parentElement;
            if (mq('(max-width: 47.9375em)') && row.scrollWidth > row.clientWidth) row.scrollTo({ left: a.offsetLeft - (row.clientWidth - a.offsetWidth) / 2, behavior: reduce ? 'auto' : 'smooth' });
          } else a.removeAttribute('aria-current');
        });
      }, { rootMargin: '-45% 0px -50% 0px' });
      ids.forEach(function (id) { var sec = document.getElementById(id); if (sec) spy.observe(sec); });
    }
  } catch (e) {}

  // Print: show everything and open every abstract, then restore.
  var details = document.querySelectorAll('details.pub__more');
  window.addEventListener('beforeprint', function () {
    showAll();
    details.forEach(function (d) { d.setAttribute('data-was-open', d.open ? '1' : ''); d.open = true; });
  });
  window.addEventListener('afterprint', function () {
    details.forEach(function (d) { d.open = d.getAttribute('data-was-open') === '1'; d.removeAttribute('data-was-open'); });
  });
})();
    </script>
  </body>
</html>
