---
// Self-hosted type (latin subsets only; Vite hashes the woff2 into _astro/).
// Source Serif 4: roman with the opsz axis (122 KB) + true italic (52 KB).
// Source Sans 3:  roman, wght axis (29 KB). Imported before global.css so the
// @font-face rules precede their first use.
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/source-sans-3/wght.css';
import serifWoff2 from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, htmlLang, ui } from '../i18n/content';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Absolute path of the equivalent page in the other language; null when none exists. */
  altUrl: string | null;
  /** Optional JSON-LD graph nodes (the homepage passes WebSite + Person). */
  jsonLd?: Record<string, unknown>[];
}

const { lang, title, description, altUrl, jsonLd } = Astro.props;
const t = ui[lang];

// Single source of truth: `site` from astro.config.mjs (lowercase host, as
// served by GitHub Pages) so canonical / og / hreflang URLs are byte-consistent.
const siteUrl = Astro.site?.href ?? 'https://beiciccc.github.io/';
const canonical = new URL(Astro.url.pathname, siteUrl).href;

// Social cards must be raster (X, Facebook, LinkedIn, Slack, iMessage do not
// render SVG). One card per language.
const ogImage = new URL(lang === 'zh' ? '/og-default.zh.png' : '/og-default.png', siteUrl).href;
const ogAlt =
  lang === 'zh'
    ? '张鲲 Kun Zhang，博士申请人，大语言模型后训练与对齐；4 篇录用，3 篇在投'
    : 'Kun Zhang 张鲲, PhD applicant, LLM post-training and alignment; 4 accepted, 3 under review';

// hreflang alternates. A page without a counterpart only declares itself.
const altCanonical = altUrl ? new URL(altUrl, siteUrl).href : null;
const enHref = lang === 'en' ? canonical : altCanonical;
const zhHref = lang === 'zh' ? canonical : altCanonical;
const xDefault = enHref ?? canonical;
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfaf6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161513" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Only the file the first paint needs (h1 + running text). The italic
         and the sans arrive via font-display: swap behind metric-matched
         fallbacks declared in global.css. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href={serifWoff2} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kun Zhang" />
    <link rel="canonical" href={canonical} />

    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    {zhHref && <link rel="alternate" hreflang="zh-Hans" href={zhHref} />}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kun Zhang" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_GB'} />
    {altCanonical && <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_GB' : 'zh_CN'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd })} />
    )}

    <!-- No-flash bootstrap: mark JS-enabled and apply a stored theme choice
         before first paint. No stored choice = follow the OS (no attribute). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var v = localStorage.getItem('theme');
          if (v === 'light' || v === 'dark') root.setAttribute('data-theme', v);
        } catch (e) {
          /* storage unavailable: follow the OS */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <Header lang={lang} altUrl={altUrl} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script is:inline>
      (function () {
        var root = document.documentElement;

        // THEME: three states, system → light → dark → system. The icon is
        // keyed off data-state (CSS); the label names the current setting.
        var btn = document.getElementById('theme-toggle');
        function stored() {
          try {
            var v = localStorage.getItem('theme');
            return v === 'light' || v === 'dark' ? v : 'system';
          } catch (e) {
            return 'system';
          }
        }
        function apply(state) {
          if (state === 'system') root.removeAttribute('data-theme');
          else root.setAttribute('data-theme', state);
          if (!btn) return;
          btn.setAttribute('data-state', state);
          var label = btn.getAttribute('data-label-' + state);
          if (label) {
            btn.setAttribute('aria-label', label);
            btn.setAttribute('title', label);
          }
        }
        apply(stored());
        if (btn) {
          btn.addEventListener('click', function () {
            var order = ['system', 'light', 'dark'];
            var next = order[(order.indexOf(stored()) + 1) % order.length];
            try {
              if (next === 'system') localStorage.removeItem('theme');
              else localStorage.setItem('theme', next);
            } catch (e) {}
            apply(next);
          });
        }

        // NAV: settle the sticky bar once scrolled. One rAF-throttled listener.
        var ticking = false;
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            document.body.classList.toggle('scrolled', window.scrollY > 8);
            ticking = false;
          });
        }
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        // PRINT: open every abstract for the printed page, then restore.
        var details = document.querySelectorAll('details.pub__more');
        window.addEventListener('beforeprint', function () {
          details.forEach(function (d) {
            d.setAttribute('data-was-open', d.open ? '1' : '');
            d.open = true;
          });
        });
        window.addEventListener('afterprint', function () {
          details.forEach(function (d) {
            d.open = d.getAttribute('data-was-open') === '1';
            d.removeAttribute('data-was-open');
          });
        });
      })();
    </script>
  </body>
</html>
